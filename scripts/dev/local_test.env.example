# Local integration test configuration.
#
# Copy this file to scripts/dev/local_test.env and edit values there:
#   cp scripts/dev/local_test.env.example scripts/dev/local_test.env
#
# The real local_test.env file is ignored by Git. Do not commit secrets.

# Optional Databricks profile for local SDK auth. Leave empty to use DEFAULT resolution.
# export DATABRICKS_CONFIG_PROFILE="DEFAULT"

# Optional IDs. Empty values make the corresponding tests skip.
GENIE_TEST_SPACE_ID=""
GENIE_TEST_CONVERSATION_ID=""
GENIE_TEST_TAG_KEY=""
GENIE_TEST_TAG_VALUE=""
DASHBOARD_TEST_ID=""
DATABRICKS_TEST_USER_ID=""
GENIE_TEST_BENCHMARK_RUN_ID=""
GENIE_TEST_BENCHMARK_RESULT_ID=""
DATABRICKS_TEST_JOB_RUN_ID=""

# Set to 1 to print tool results while running pytest with -s.
PRINT_TOOL_RESULTS=""

# Non-secret app configuration mirrored from app.yaml.
GENIE_SERIALIZATION_JOB_ID="405956489806901"
GENIE_RESTORE_POINTS_JOB_ID="191614083444231"
GENIE_RESTORE_JOB_ID="411926808267885"
GENIE_SPACE_WAREHOUSE_ID="38cb31e24512fd55"
ATLAN_BASE_URL="https://hp.atlan.com/"

# Optional secret for local Atlan calls. Leave empty unless testing Atlan locally.
ATLAN_API_KEY=""
